+++ b/packages/vasta-runtime/src/vasta_runtime/control.py
@@ -0,0 +1,131 @@
+"""人工控制：暂停/接管/批准/撤销（FR-052，Story 3.6）。"""
+
+from __future__ import annotations
+
+from vasta_protocols.errors import VastaError
+
+from .state import RunState
+
+
+class TakeoverRequiredError(VastaError):
+    def __init__(self, op: str) -> None:
+        super().__init__(
+            code="control.takeover_required",
+            message=f"接管模式下 {op} 需人工确认（confirm=True）",
+            retryable=False,
+        )
+        self.op = op
+
+
+class RevocationError(VastaError):
+    def __init__(self, reason: str) -> None:
+        super().__init__(
+            code="control.revocation_failed",
+            message=f"撤销失败：{reason}",
+            retryable=False,
+        )
+
+
+class HumanControlMixin:
+    """挂载于 RunEngine（3.6）：接管模式 + 批准/撤销正式 API。
+
+    - takeover()：进入接管模式——后续 step/execute_contracted 需 confirm=True；
+    - release_control()：解除接管；
+    - approve_pending(contract)：R3 暂停态下的正式批准入口（内部转
+      execute_contracted(approved=True) 续行）；
+    - revoke(contract)：撤销已批准未执行的动作（批准不可撤销已执行的）。
+    """
+
+    async def takeover(self) -> None:
+        """进入接管模式（人工逐动作确认）。"""
+        if self._state is not RunState.STARTED:  # noqa: SLF001
+            raise VastaError(
+                code="run.not_started",
+                message=f"takeover requires started run, current={self._state.value}",  # noqa: SLF001
+            )
+        self._takeover_mode = True  # noqa: SLF001
+        await self._emit(  # noqa: SLF001
+            "run.takeover", {"mode": "human", "note": "后续动作需人工确认"}
+        )
+
+    async def release_control(self) -> None:
+        """解除接管模式。"""
+        self._takeover_mode = False  # noqa: SLF001
+        await self._emit(  # noqa: SLF001
+            "run.control_released", {"mode": "auto"}
+        )
+
+    @property
+    def takeover_mode(self) -> bool:
+        return getattr(self, "_takeover_mode", False)
+
+    def _check_takeover(self, op: str, confirmed: bool) -> None:
+        """接管模式下未确认的操作：落事件并抛出（调用方 async 上下文）。"""
+        if self.takeover_mode and not confirmed:
+            raise TakeoverRequiredError(op)
+
+    async def _takeover_gate(self, op: str, confirmed: bool) -> None:
+        if self.takeover_mode and not confirmed:
+            await self._emit(  # noqa: SLF001
+                "action.takeover_required", {"op": op}
+            )
+            raise TakeoverRequiredError(op)
+
+    async def approve_pending(self, contract, **kwargs) -> list:  # noqa: ANN001, ANN202
+        """正式批准入口：从 R3 暂停态批准并续行该动作。
+
+        要求当前为 paused（approval 暂停）；批准后自动 resume 再以
+        approved=True 续行——六段链完整（3.3 语义正式化）。"""
+        from vasta_contracts import ActionContract  # 延迟导入避免环
+
+        if not isinstance(contract, ActionContract):
+            raise VastaError(code="control.bad_contract", message="需 ActionContract")
+        if self._state is not RunState.PAUSED:  # noqa: SLF001
+            raise VastaError(
+                code="run.not_paused",
+                message=f"approve_pending requires paused run, current={self._state.value}",  # noqa: SLF001
+            )
+        await self.resume()  # noqa: SLF001
+        return await self.execute_contracted(  # noqa: SLF001
+            contract, approved=True, **kwargs
+        )
+
+    async def revoke(self, contract) -> None:  # noqa: ANN001
+        """撤销已批准未执行的动作批准。
+
+        - 已批准且未执行（计划步仍 pending/invalidated）→ 撤销 + 事件；
+        - 已执行的不可撤销（撤销=补偿，FR-038 Stage 3）。"""
+        from vasta_contracts import ActionContract
+
+        if not isinstance(contract, ActionContract):
+            raise VastaError(code="control.bad_contract", message="需 ActionContract")
+        # 找最近的 approved 事件
+        approved = [
+            e
+            for e in self.store.iter_run_events(self.config.run_id)  # noqa: SLF001
+            if e.type == "action.approved"
+        ]
+        if not approved or approved[-1].payload.get("tool") != contract.tool:
+            raise RevocationError(f"未找到 {contract.tool!r} 的待执行批准记录")
+        # 其后若已有 executed → 已执行不可撤销
+        events = list(self.store.iter_run_events(self.config.run_id))  # noqa: SLF001
+        last_approved_seq = approved[-1].seq
+        executed_after = [
+            e
+            for e in events
+            if e.seq > last_approved_seq
+            and e.type == "action.executed"
+            and e.payload.get("tool") == contract.tool
+        ]
+        if executed_after:
+            raise RevocationError(
+                f"{contract.tool!r} 已执行——撤销已执行动作属补偿（FR-038，Stage 3）"
+            )
+        await self._emit(  # noqa: SLF001
+            "action.approval_revoked",
+            {"tool": contract.tool, "revoked_by": "human-local",
+             "original_approval_seq": last_approved_seq},
+        )
+
+
+__all__ = ["HumanControlMixin", "RevocationError", "TakeoverRequiredError"]
diff --git a/packages/vasta-runtime/src/vasta_runtime/gateway.py b/packages/vasta-runtime/src/vasta_runtime/gateway.py
new file mode 100644
index 0000000..0734454
--- /dev/null
+++ b/packages/vasta-runtime/src/vasta_runtime/gateway.py
@@ -0,0 +1,116 @@
+"""ToolGateway：写动作唯一通道与幂等键派生（FR-032，AD-4/AD-11，Story 3.2）。
+
+- 注册表是业务工具适配器/凭证的唯一持有处（AD-4）——引擎与模型侧只见到网关；
+- 分类强制：read_only/risk 一律取自清单；契约自报仅作 declared 记录；
+- 幂等（AD-11）：键 = run_id:plan_step_id:tool:canonical_args_hash；
+  命中返回原结果 + replayed=True，适配器零调用、预算零消耗；
+- dry_run 门：清单声明 supports_dry_run 时先试运行，不允许则不触执行。
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Any
+
+from vasta_protocols.errors import VastaError
+from vasta_protocols.protocols import Action, ToolAdapter, ToolResult
+
+
+def canonical_args_hash(args: dict[str, Any]) -> str:
+    """键序无关的参数规范化哈希（AD-11 幂等键组成）。"""
+    canonical = json.dumps(
+        args or {}, sort_keys=True, separators=(",", ":"), default=repr
+    )
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
+
+def idempotency_key(
+    run_id: str, plan_step_id: str, tool: str, args: dict[str, Any]
+) -> str:
+    """AD-11 唯一确定函数：幂等键派生（禁止各单元自定）。"""
+    return f"{run_id}:{plan_step_id}:{tool}:{canonical_args_hash(args)}"
+
+
+class ToolNotRegisteredError(VastaError):
+    def __init__(self, tool: str) -> None:
+        super().__init__(
+            code="tool.not_registered",
+            message=f"工具 {tool!r} 未在网关注册（清单缺失，FR-032）",
+            retryable=False,
+        )
+        self.tool = tool
+
+
+class DuplicateToolError(VastaError):
+    def __init__(self, name: str) -> None:
+        super().__init__(
+            code="tool.duplicate_registration",
+            message=f"工具名 {name!r} 已注册（同名单工具拒绝重复注册）",
+            retryable=False,
+        )
+
+
+class ToolGateway:
+    """写动作唯一执行通道（AD-4）。
+
+    引擎/模型侧不 import 适配器；一切工具调用经此。MVP 幂等缓存为内存态
+    （Stage 3 随 FR-038 持久化）。
+    """
+
+    def __init__(self) -> None:
+        self._tools: dict[str, ToolAdapter] = {}
+        self._results: dict[str, ToolResult] = {}
+
+    # ---- 注册 ----
+    def register(self, adapter: ToolAdapter) -> None:
+        """注册工具适配器；清单经 ToolManifest（pydantic）即已强制完整。"""
+        manifest = adapter.manifest  # 缺字段在清单构造期即抛（FR-032）
+        if manifest.name in self._tools:
+            raise DuplicateToolError(manifest.name)
+        self._tools[manifest.name] = adapter
+
+    def registered_tools(self) -> list[str]:
+        return sorted(self._tools)
+
+    # ---- 分类（AD-4：清单强制，调用方自声明无效）----
+    def classify(self, tool: str) -> tuple[bool, str]:
+        """返回 (read_only, risk)，全部取自清单；未注册即拒。"""
+        adapter = self._tools.get(tool)
+        if adapter is None:
+            raise ToolNotRegisteredError(tool)
+        return adapter.manifest.read_only, adapter.manifest.risk
+
+    # ---- 幂等（AD-11）----
+    def is_replay(self, run_id: str, plan_step_id: str, action: Action) -> bool:
+        """该请求是否为幂等命中（预算闸对其放行，AD-11）。"""
+        key = idempotency_key(run_id, plan_step_id, action.tool, action.args)
+        return key in self._results
+
+    # ---- 执行 ----
+    async def execute(
+        self,
+        *,
+        run_id: str,
+        plan_step_id: str,
+        action: Action,
+    ) -> ToolResult:
+        """经网关执行工具：幂等短路 → dry_run 门 → 适配器执行 → 缓存。"""
+        adapter = self._tools.get(action.tool)
+        if adapter is None:
+            raise ToolNotRegisteredError(action.tool)
+        key = idempotency_key(run_id, plan_step_id, action.tool, action.args)
+        cached = self._results.get(key)
+        if cached is not None:
+            return cached.model_copy(update={"replayed": True})  # 绝不静默重执行
+        if adapter.manifest.supports_dry_run:
+            dry = await adapter.dry_run(action)
+            if not dry.allowed:
+                result = ToolResult(
+                    ok=False, detail={"phase": "dry_run", "reason": dry.reason}
+                )
+                self._results[key] = result
+                return result
+        result = await adapter.execute(action, idempotency_key=key)
+        self._results[key] = result
+        return result
